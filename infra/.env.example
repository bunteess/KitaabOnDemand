# Optional overrides for the development compose stack. Copy to infra/.env.
# The API's own settings are set in docker-compose.yml (x-api-env) and listed
# with explanations in services/api/.env.example.

# Registry for third-party images. Use a mirror if Docker Hub rate-limits you,
# for example mirror.gcr.io.
DOCKER_REGISTRY=docker.io

# Extra CA certificate for builds behind a TLS-intercepting proxy. Leave unset
# normally; the default is an empty file.
# BUILD_CA_FILE=./docker/.build-ca.crt

# Host ports
POSTGRES_PORT=5432
REDIS_PORT=6379
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
API_PORT=8000
WEB_PORT=8080

# How phones and browsers reach the API and storage. Use your machine's LAN
# address to test on a real phone, for example http://192.168.1.20:8000.
PUBLIC_BASE_URL=http://localhost:8000
S3_PUBLIC_ENDPOINT_URL=http://localhost:9000

LOG_LEVEL=INFO
WEB_CONCURRENCY=2             # API worker processes
REVIEW_MODE_ENABLED=false
CLAMAV_ENABLED=false          # true with `docker compose --profile clamav up`

# Mock providers: share of calls that fail, and average delay.
MOCK_PROVIDER_FAILURE_RATE=0
MOCK_PROVIDER_LATENCY_MS=150
