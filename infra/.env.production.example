# Production settings for infra/docker-compose.prod.yml (docs/DEPLOY.md).
# Copy to infra/.env.production on the server, fill in every value and keep it
# out of git (chmod 600). Generate secrets with:  openssl rand -base64 48
# The API refuses to start if anything here is unsafe (kitaab/config.py).

# -- release and domains (used by compose and Caddy)
VERSION=v1.0.0
IMAGE_PREFIX=ghcr.io/bunteess/kitaabondemand
API_DOMAIN=api.example.pk
PORTAL_DOMAIN=portal.example.pk
ACME_EMAIL=ops@example.pk

# -- database (the postgres and backup containers read these too)
POSTGRES_USER=kitaab
POSTGRES_PASSWORD=
POSTGRES_DB=kitaab
DATABASE_URL=postgresql+psycopg://kitaab:REPLACE_WITH_POSTGRES_PASSWORD@postgres:5432/kitaab
REDIS_URL=redis://redis:6379/0
BACKUP_KEEP_DAYS=14                 # dumps kept on the server
# Off-server copies (outputs of infra/terraform; a separate IAM user that can
# only add dumps). Leave the bucket empty only if Postgres is a managed
# service with its own backups.
BACKUP_S3_BUCKET=kitaabondemand-backups-prod
BACKUP_AWS_ACCESS_KEY_ID=
BACKUP_AWS_SECRET_ACCESS_KEY=

# -- API
ENVIRONMENT=production
LOG_LEVEL=INFO
WEB_CONCURRENCY=2
THREADPOOL_SIZE=40
DB_POOL_SIZE=10
PUBLIC_BASE_URL=https://api.example.pk
INTERNAL_API_URL=http://api:8000
WEB_ORIGINS=https://portal.example.pk
SENTRY_DSN=

# -- secrets: at least 32 random characters each, never reused between environments
JWT_SECRET=
OTP_PEPPER=
DATA_ENCRYPTION_KEY=
MOCK_WEBHOOK_SECRET=

# -- storage (outputs of infra/terraform; access key created in the IAM console)
S3_BUCKET=kitaabondemand-uploads-prod
S3_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# -- virus scanning (the clamav container)
CLAMAV_ENABLED=true
CLAMAV_HOST=clamav
CLAMAV_PORT=3310

# -- providers (docs/INTEGRATIONS.md). Leave PAYMENT_PROVIDERS empty to launch
# with cash on delivery only; with COURIER_PROVIDERS empty, admins type CNs.
SMS_PROVIDER=
SMS_FALLBACK_ENABLED=false
PAYMENT_PROVIDERS=
COURIER_PROVIDERS=
PUSH_PROVIDER=fcm
FCM_CREDENTIALS_FILE=/run/secrets/fcm-service-account.json
GOOGLE_OAUTH_CLIENT_IDS=

# -- store review (docs/DECISIONS.md D-020): only during a review window
REVIEW_MODE_ENABLED=false
ALLOW_REVIEW_MODE_IN_PRODUCTION=false

DEV_TOOLS_ENABLED=false
