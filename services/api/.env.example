# KitaabOnDemand API settings (kitaab/config.py). Copy to .env for running the
# API on the host (`make api-dev`); docker compose sets its own values.
# Every value here is a development default. Never commit real secrets.
# With ENVIRONMENT=production the API refuses to start on unsafe values.

# -- general
ENVIRONMENT=development            # development | test | staging | production
DEBUG=false
LOG_LEVEL=INFO
SENTRY_DSN=

# -- data stores
DATABASE_URL=postgresql+psycopg://kitaab:kitaab@localhost:5432/kitaab
REDIS_URL=redis://localhost:6379/0

# -- secrets: generate long random values for staging and production
JWT_SECRET=dev-only-jwt-secret-change-me-0123456789abcdef
OTP_PEPPER=dev-only-otp-pepper-change-me
# Encrypts admin TOTP secrets at rest.
DATA_ENCRYPTION_KEY=ZGV2LW9ubHkta2V5LWNoYW5nZS1tZS0wMTIzNDU2Nzg=
MOCK_WEBHOOK_SECRET=dev-only-mock-webhook-secret

# -- tokens
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30

# -- URLs
PUBLIC_BASE_URL=http://localhost:8000      # how phones and gateways reach the API
INTERNAL_API_URL=http://localhost:8000     # how the worker reaches the API
WEB_ORIGINS=http://localhost:5173,http://localhost:8080

# -- object storage (credentials come from AWS_* variables or an instance role)
S3_BUCKET=kitaab-dev
S3_REGION=ap-south-1
S3_ENDPOINT_URL=http://localhost:9000          # leave empty for AWS S3
S3_PUBLIC_ENDPOINT_URL=http://localhost:9000   # host used in presigned URLs
AWS_ACCESS_KEY_ID=kitaab-minio
AWS_SECRET_ACCESS_KEY=kitaab-minio-secret

# -- uploads and files
MAX_UPLOAD_BYTES=157286400          # 150 MB
UPLOAD_PART_BYTES=8388608           # 8 MB parts
UPLOAD_URL_TTL_SECONDS=86400
DOWNLOAD_URL_TTL_SECONDS=300
UNATTACHED_UPLOAD_TTL_HOURS=24
PURGE_DAYS=7
PURGE_DRY_RUN=false
CLAMAV_ENABLED=false                # must be true in production
CLAMAV_HOST=localhost
CLAMAV_PORT=3310

# -- orders
PENDING_PAYMENT_TTL_HOURS=24
QUOTE_VALIDITY_HOURS_DEFAULT=48

# -- customer sign-in codes
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_DAILY_CAP_PER_PHONE=10
OTP_REQUESTS_PER_IP_PER_HOUR=30

# -- staff sign-in
STAFF_MAX_FAILED_LOGINS=5
STAFF_LOCKOUT_MINUTES=15

# -- store reviewer demo account (docs/DECISIONS.md D-020)
REVIEW_MODE_ENABLED=false
ALLOW_REVIEW_MODE_IN_PRODUCTION=false
REVIEW_PHONE=+923000000000
REVIEW_OTP=000000                   # change before enabling in production

# -- development helpers: adjustable clock, SMS outbox, mock controls
DEV_TOOLS_ENABLED=true              # must be false in production

# -- providers (docs/INTEGRATIONS.md)
SMS_PROVIDER=mock
SMS_FALLBACK_ENABLED=false
PAYMENT_PROVIDERS=mock              # e.g. easypaisa,jazzcash,card once built
COURIER_PROVIDERS=mock              # e.g. trax,leopards,tcs once built
PUSH_PROVIDER=fake                  # fcm in production
FCM_CREDENTIALS_FILE=               # path to the Firebase service account JSON
GOOGLE_OAUTH_CLIENT_IDS=            # comma-separated; the web client ID first
MOCK_PROVIDER_FAILURE_RATE=0
MOCK_PROVIDER_LATENCY_MS=0

# -- legal
TERMS_VERSION=placeholder-2026-10
