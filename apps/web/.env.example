# Portal build settings. Copy to apps/web/.env.local for local overrides.
# The portal calls the API on its own origin under /api: Caddy proxies it in
# the container, and the Vite dev server proxies it below.

# Run against the in-memory mock API instead of a real server (D-041).
VITE_MOCK_API=false

# Where `npm run dev` forwards /api requests. vite.config.ts reads this from the
# shell, for example `VITE_DEV_API_PROXY=http://192.168.1.20:8000 npm run dev`.
VITE_DEV_API_PROXY=http://localhost:8000
